# remove from airootfs!
[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = pacman-mirrorlist

[Action]
Description = Uncommenting mirrorlist for the live ISO...
When = PostTransaction
Depends = pacman-mirrorlist
Exec = /bin/sh -c 'sed -i "s/^#Server/Server/" /etc/pacman.d/mirrorlist'
