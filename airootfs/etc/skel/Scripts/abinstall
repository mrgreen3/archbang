  ["हिन्दी"]="hi_IN"
  ["ไทย"]="th_TH"
  ["Tiếng Việt"]="vi_VN"
)

select_language() {
  print_title "LANGUAGE - ${WIKI}/Locale"
  print_info "Select your language. This sets the system locale."

  mapfile -t _lang_list < <(printf '%s\n' "${!CURATED_LOCALES[@]}" "More languages..." | sort)

  OPTION=n
  while [[ $OPTION != y ]]; do
    PS3="$prompt1"
    echo "Select language:"
    select LANG_CHOICE in "${_lang_list[@]}"; do
      if contains_element "$LANG_CHOICE" "${_lang_list[@]}"; then
        break
      else
        invalid_option
      fi
    done
    read_input_text "Confirm language: $LANG_CHOICE"
  done

  if [[ "$LANG_CHOICE" == "More languages..." ]]; then
    DERIVED_LOCALE=""
  else
    DERIVED_LOCALE="${CURATED_LOCALES[$LANG_CHOICE]}"
  fi
}
#}}}
#}}}

WIKI="https://wiki.archlinux.org/index.php"

#ARCHLINUX INSTALL SCRIPTS MODE {{{
#CONFIGURE VCONSOLE {{{
configure_vconsole(){
  print_title "CONSOLE KEYMAP"
  # Fixed to "us" rather than prompted: this only affects the raw tty
  # console (rescue/recovery, before a desktop is running), and almost
  # every user is on mango/Wayland day to day, whose own keyboard layout
  # is set separately in select_xkeymap below (derived from location).
  # Documents/Guide covers editing /etc/vconsole.conf post-install for
  # anyone who actually needs a different console layout.
  print_info "Using 'us' for the console (tty) layout — see Documents/Guide to change it later."
  echo "KEYMAP=us" > ${MNT}/etc/vconsole.conf
}
#}}}
#SELECT KEYMAP {{{
select_xkeymap(){
  print_title "MANGO DESKTOP KEYBOARD LAYOUT"
  print_info "Setting keyboard layout for mango compositor"
  if [[ -n "$DERIVED_XKB" ]]; then
    XKEYMAP="$DERIVED_XKB"
    print_success "Using keyboard layout ${XKEYMAP} (derived from ${LOCATION:-your location})."
  else
    OPTION=n
    while [[ $OPTION != y ]]; do
      getxkeymap
      read_input_text "Confirm keymap: $XKEYMAP"
    done
  fi
   sed -i "s/xkb_rules_layout=.*/xkb_rules_layout=${XKEYMAP}/" $MNT/home/${LIVE_USER}/.config/mango/config.conf
}
#}}}

#UMOUNT PARTITIONS {{{
umount_partitions(){
  mounted_partitions=(`lsblk | grep ${MNT} | awk '{print $7}' | sort -r`)
  swapoff -a
  for i in ${mounted_partitions[@]}; do
    umount $i
  done
}
#}}}
#SELECT DEVICE {{{
select_device(){
  local NAME SIZE MODEL TRAN path label
  devices_list=()
  local display_list=()
  local tran_list=()
  while IFS= read -r line; do
    NAME=""; SIZE=""; MODEL=""; TRAN=""
    # Parse KEY="value" pairs without eval — MODEL comes from device
    # firmware/USB descriptors, which a hostile USB drive could spoof to
    # inject shell commands if this were eval'd.
    while [[ "$line" =~ ^([A-Z]+)=\"([^\"]*)\"[[:space:]]*(.*)$ ]]; do
      case "${BASH_REMATCH[1]}" in
        NAME)  NAME="${BASH_REMATCH[2]}" ;;
        SIZE)  SIZE="${BASH_REMATCH[2]}" ;;
        MODEL) MODEL="${BASH_REMATCH[2]}" ;;
        TRAN)  TRAN="${BASH_REMATCH[2]}" ;;
      esac
      line="${BASH_REMATCH[3]}"
    done
    [[ "$NAME" =~ ^(mmc|nvme|sd|hd|vd) ]] || continue
    path="/dev/${NAME}"
    label="${path}  ${SIZE}  ${MODEL:-unknown}  [${TRAN:-?}]"
    if [[ "$TRAN" == "usb" ]]; then
      label="${BGreen}${label}  <-- USB / EXTERNAL${Reset}"
    fi
    devices_list+=("$path")
    display_list+=("$label")
    tran_list+=("$TRAN")
  done < <(lsblk -Pdo NAME,SIZE,MODEL,TRAN)

  PS3="$prompt1"
  echo -e "Select drive:\n"
  select opt in "${display_list[@]}"; do
    if [[ -n "$opt" && $REPLY -ge 1 && $REPLY -le ${#devices_list[@]} ]]; then
      device="${devices_list[$((REPLY-1))]}"
      DEVICE_TRAN="${tran_list[$((REPLY-1))]}"
      break
    else
      invalid_option
    fi
  done
  BOOT_MNT=$device
}
#}}}
#CREATE PARTITION SCHEME {{{
create_partition_scheme(){
  LUKS=0
  LVM=0
  print_title "PARTITION DRIVE - ${WIKI}/Partitioning"
  print_danger "WARNING: This step will partition your disk. All data on the selected device will be permanently lost. Make sure you have backed up anything important before continuing."
  read_input_text "I understand my data will be lost. Continue"
  if [[ $OPTION != y ]]; then
    print_info "Partitioning cancelled."
    return 1
  fi
  print_info "Partitioning a hard drive allows one to logically divide the available space into sections that can be accessed independently of one another."
  print_warning "Maintain Current does not work with LUKS"
  partition_layout=("Auto (erase disk)" "Default" "LVM" "LVM+LUKS" "Maintain Current")
  PS3="$prompt1"
  echo -e "Select partition scheme:"
  select OPT in "${partition_layout[@]}"; do
    case "$REPLY" in
      1)
        auto_partition_disk
        ;;
      2)
        create_partition
        ;;
      3)
        create_partition
        setup_lvm
        ;;
      4)
        create_partition
        setup_luks
        setup_lvm
        ;;
      5)
        modprobe dm-mod
        vgscan &> /dev/null
        vgchange -ay &> /dev/null
        ;;
      *)
        invalid_option
        ;;
    esac
    [[ -n $OPT ]] && break
  done
}
#}}}
#AUTO PARTITION{{{
partition_suffix() {
  [[ "$1" =~ (nvme|mmcblk) ]] && echo "p" || echo ""
}

auto_partition_disk() {
  print_title "AUTO PARTITION - ${WIKI}/Partitioning"
  print_danger "WARNING: This will ERASE ALL DATA on the selected device."
  select_device
  device="${BOOT_MNT}"

  read_input_text "This will erase ALL data on ${device}. Continue"
  if [[ $OPTION != y ]]; then
    print_info "Auto-partitioning cancelled."
    return 1
  fi

  if [[ "$DEVICE_TRAN" == "usb" ]]; then
    PORTABLE_INSTALL=1
    print_info "USB target detected — will install hybrid BIOS+UEFI GRUB for portability."
  else
    PORTABLE_INSTALL=0
  fi

  local suffix=$(partition_suffix "${device}")

  # --- compute swap size from total RAM (no swap partition above 8GiB RAM) ---
  local mem_kib=$(grep MemTotal /proc/meminfo | awk '{print $2}')
  local mem_gib=$(( (mem_kib + 1048575) / 1048576 ))
  local swap_gib
  if [[ $mem_gib -le 2 ]]; then
    swap_gib=$(( mem_gib * 2 ))
  elif [[ $mem_gib -le 8 ]]; then
    swap_gib=$mem_gib
  else
    swap_gib=0
  fi

  if [[ $swap_gib -gt 0 ]]; then
    print_info "Partitioning ${device} (swap: ${swap_gib}GiB)..."
  else
    print_info "Partitioning ${device} (no swap partition — RAM > 8GiB)..."
  fi

  umount_partitions
  swapoff -a &>/dev/null

  wipefs -af "${device}" &>/dev/null

  BIOS_GRUB_PART=""

  if [[ $PORTABLE_INSTALL -eq 1 ]]; then
    # GPT + ESP + bios_grub, regardless of this machine's own firmware mode,
    # so the drive boots on both UEFI and legacy-BIOS targets (see
    # configure_bootloader, which installs GRUB twice for this case).
    BIOS_GRUB_PART="${device}${suffix}1"
    EFI_PART="${device}${suffix}2"

    if [[ $swap_gib -gt 0 ]]; then
      SWAP_PART="${device}${suffix}3"
      ROOT_PART="${device}${suffix}4"

      parted -s "${device}" mklabel gpt \
        mkpart primary 1MiB 2MiB set 1 bios_grub on \
        mkpart primary fat32 2MiB 514MiB set 2 esp on \
        mkpart primary linux-swap 514MiB "$(( 514 + swap_gib * 1024 ))MiB" \
        mkpart primary ext4 "$(( 514 + swap_gib * 1024 ))MiB" 100% || return 1
    else
      SWAP_PART=""
      ROOT_PART="${device}${suffix}3"

      parted -s "${device}" mklabel gpt \
        mkpart primary 1MiB 2MiB set 1 bios_grub on \
        mkpart primary fat32 2MiB 514MiB set 2 esp on \
        mkpart primary ext4 514MiB 100% || return 1
    fi
  elif [[ $UEFI -eq 1 ]]; then
    EFI_PART="${device}${suffix}1"

    if [[ $swap_gib -gt 0 ]]; then
      SWAP_PART="${device}${suffix}2"
      ROOT_PART="${device}${suffix}3"

      parted -s "${device}" mklabel gpt \
        mkpart primary fat32 1MiB 513MiB set 1 esp on \
        mkpart primary linux-swap 513MiB "$(( 513 + swap_gib * 1024 ))MiB" \
        mkpart primary ext4 "$(( 513 + swap_gib * 1024 ))MiB" 100% || return 1
    else
      SWAP_PART=""
      ROOT_PART="${device}${suffix}2"

      parted -s "${device}" mklabel gpt \
        mkpart primary fat32 1MiB 513MiB set 1 esp on \
        mkpart primary ext4 513MiB 100% || return 1
    fi
  else
    EFI_PART=""

    if [[ $swap_gib -gt 0 ]]; then
      SWAP_PART="${device}${suffix}1"
      ROOT_PART="${device}${suffix}2"

      parted -s "${device}" mklabel msdos \
        mkpart primary linux-swap 1MiB "$(( 1 + swap_gib * 1024 ))MiB" \
        mkpart primary ext4 "$(( 1 + swap_gib * 1024 ))MiB" 100% || return 1
    else
      SWAP_PART=""
      ROOT_PART="${device}${suffix}1"

      parted -s "${device}" mklabel msdos \
        mkpart primary ext4 1MiB 100% || return 1
    fi
  fi

  partprobe "${device}" &>/dev/null
  udevadm settle 2>/dev/null || sleep 2

  if [[ -n "$EFI_PART" ]]; then
    mkfs.vfat -F32 "${EFI_PART}" || return 1
  fi
  if [[ -n "$SWAP_PART" ]]; then
    mkswap "${SWAP_PART}" || return 1
  fi
  mkfs.ext4 -F $([[ $TRIM -eq 1 ]] && echo "-E discard") "${ROOT_PART}" || return 1

  mount "${ROOT_PART}" "${MNT}"
  if [[ -n "$EFI_PART" ]]; then
    mkdir -p "${MNT}/boot"
    mount "${EFI_PART}" "${MNT}/boot"
  fi
  if [[ -n "$SWAP_PART" ]]; then
    swapon "${SWAP_PART}"
  fi

  ROOT_MNT="${ROOT_PART}"
  LUKS=0
  LVM=0
  AUTO_PARTITIONED=1

  print_success "Auto-partitioning of ${device} complete."
  pause_function
}
#}}}
#SETUP PARTITION{{{
create_partition() {
  print_title "SELECT PARTITION TOOL"
  apps_list=("gparted" "cfdisk" "cgdisk" "fdisk" "gdisk" "parted")
  PS3="$prompt1"
  echo -e "Select partition program:"
  select OPT in "${apps_list[@]}"; do
    if contains_element "$OPT" "${apps_list[@]}"; then
      select_device

      case "$OPT" in
        gparted)
          gparted
          ;;
        parted)
          parted -a opt "${device}"
          ;;
        *)
          $OPT "${device}"
          ;;
      esac

      echo "Press ENTER to return to installer..."
      read
      break
    else
      invalid_option
    fi
  done
}
#}}}
#SETUP LUKS {{{
setup_luks() {
  print_title "LUKS - ${WIKI}/LUKS"
  print_info "The Linux Unified Key Setup (LUKS) provides full-disk encryption for Linux."
  print_danger "\tDo not use this for /boot or EFI partitions."

  # list available partitions, skipping EFI/boot and existing mapper devices
  block_list=($(lsblk -nrpo NAME,TYPE,MOUNTPOINT | awk '$2=="part" && $3=="" {print $1}'))
  PS3="$prompt1"
  echo -e "Select partition to encrypt with LUKS:"
  select OPT in "${block_list[@]}" "Cancel"; do
    if contains_element "$OPT" "${block_list[@]}"; then
      # confirm not encrypting an EFI/boot partition — checked by actual
      # filesystem type, not a "partition name ends in 1" heuristic (which
      # misfires on e.g. nvme0n1p11 and misses EFI parts numbered >1)
      _fstype=$(blkid -s TYPE -o value "$OPT" 2>/dev/null)
      if [[ "$_fstype" == "vfat" ]]; then
        print_error "$OPT is formatted vfat (likely EFI or /boot); skipping."
        return 1
      fi

      print_info "Setting up LUKS on $OPT ..."
      cryptsetup --cipher aes-xts-plain64 --key-size 512 --hash sha512 \
                 --iter-time 5000 --verify-passphrase luksFormat "$OPT" || return 1

      print_info "Opening LUKS container..."
      if [[ $TRIM -eq 1 ]]; then
        cryptsetup open --type luks --allow-discards "$OPT" "${LUKS_NAME}"
      else
        cryptsetup open --type luks "$OPT" "${LUKS_NAME}"
      fi

      # mark LUKS enabled and record device info
      LUKS=1
      LUKS_PART="$OPT"
      LUKS_MAPPER="/dev/mapper/${LUKS_NAME}"
      export LUKS LUKS_NAME LUKS_PART LUKS_MAPPER

      print_success "LUKS container created at ${LUKS_MAPPER}"
      break

    elif [[ "$OPT" == "Cancel" ]]; then
      print_warning "LUKS setup cancelled."
      return 1
    else
      invalid_option
    fi
  done
}

#}}}
#SETUP LVM {{{
setup_lvm() {
  print_title "LVM - ${WIKI}/LVM"
  print_info "LVM manages logical volumes inside your selected device."
  print_warning "Last logical volume will take 100% of remaining space."

  # Determine target device
  if [[ $LUKS -eq 1 ]]; then
    TARGET_DEV="/dev/mapper/${LUKS_NAME}"
  else
    block_list=($(lsblk -nrpo NAME,TYPE | awk '$2=="part"{print $1}'))
    PS3="$prompt1"
    echo -e "Select partition:"
    select OPT in "${block_list[@]}"; do
      if contains_element "$OPT" "${block_list[@]}"; then
        TARGET_DEV="$OPT"
        break
      else
        invalid_option
      fi
    done
  fi

  # Safety check
  if [[ -z "$TARGET_DEV" ]]; then
    print_error "No valid target device selected."
    return 1
  fi

  # Initialise LVM
  pvcreate "$TARGET_DEV"
  vgcreate "$VG_NAME" "$TARGET_DEV"

  # Ask only for root + extras
  while true; do
    read -p "Enter root volume size (e.g. 25G): " ROOT_SIZE
    [[ "$ROOT_SIZE" =~ ^[0-9]+(\.[0-9]+)?[KkMmGgTt][Ii]?[Bb]?$ ]] && break
    print_danger "Invalid size. Use a number followed by a unit, e.g. 25G or 500M."
  done
  lvcreate -L "${ROOT_SIZE}" "$VG_NAME" -n root

  echo
  print_info "Now you can add extra volumes such as home, var, swap..."
  while true; do
    read -p "How many extra volumes? [0-9]: " extra_count
    [[ "$extra_count" =~ ^[0-9]+$ ]] && break
    print_danger "Enter a whole number (0 or more)."
  done

  i=1
  while [[ $i -le $extra_count ]]; do
    read -p "Name for volume $i (e.g. home): " lvname
    if [[ $i -eq $extra_count ]]; then
      lvcreate -l 100%FREE "$VG_NAME" -n "$lvname"
    else
      while true; do
        read -p "Size for $lvname (e.g. 10G): " lvsize
        [[ "$lvsize" =~ ^[0-9]+(\.[0-9]+)?[KkMmGgTt][Ii]?[Bb]?$ ]] && break
        print_danger "Invalid size. Use a number followed by a unit, e.g. 10G or 500M."
      done
      lvcreate -L "$lvsize" "$VG_NAME" -n "$lvname"
    fi
    i=$((i+1))
  done

  LVM=1
  export LVM VG_NAME
}

#}}}
#SELECT|FORMAT PARTITIONS {{{
format_partitions(){
  if [[ $AUTO_PARTITIONED -eq 1 ]]; then
    print_info "Disk already partitioned and formatted (auto)."
    return 0
  fi

  print_title "FILESYSTEMS - ${WIKI}/File_Systems"
  print_info "This step will select and format the selected partiton where the archlinux will be installed"
  print_danger "\tAll data on the ROOT and SWAP partition will be LOST."
  i=0

  # lsblk -p gives full /dev/... paths; strip to bare device name so the
  # loop below can prepend /dev/ or /dev/mapper/ as appropriate. A bare
  # substr()-based prefix strip (the old approach) truncated NVMe/mmcblk
  # names, which use a longer "nvme0n1p1"/"mmcblk0p1" naming scheme.
  block_list=($(lsblk -nrpo NAME,TYPE | awk '$2=="part" || $2=="lvm" {sub(/^.*\//,"",$1); print $1}'))

  # check if there is no partition
  if [[ ${#block_list[@]} -eq 0 ]]; then
    echo "No partition found"
    exit 0
  fi

  partitions_list=()
  for OPT in ${block_list[@]}; do
    check_lvm=`echo $OPT | grep lvm`
    if [[ -z $check_lvm ]]; then
      partitions_list+=("/dev/$OPT")
    else
      partitions_list+=("/dev/mapper/$OPT")
    fi
  done

  # partitions based on boot system
  if [[ $UEFI -eq 1 ]]; then
    partition_name=("root" "EFI" "swap" "another")
  else
    partition_name=("root" "swap" "another")
  fi

  select_filesystem(){
    filesystems_list=( "btrfs" "ext2" "ext3" "ext4" "f2fs" "jfs" "nilfs2" "ntfs" "vfat" "xfs");
    PS3="$prompt1"
    echo -e "Select filesystem:\n"
    select filesystem in "${filesystems_list[@]}"; do
      if contains_element "${filesystem}" "${filesystems_list[@]}"; then
        break
      else
        invalid_option
      fi
    done
  }

  disable_partition(){
    #remove the selected partition from list
    unset partitions_list[${partition_number}]
    partitions_list=(${partitions_list[@]})
    #increase i
    [[ ${partition_name[i]} != another ]] && i=$(( i + 1 ))
  }

  format_partition(){
    read_input_text "Confirm format $1 partition"
    if [[ $OPTION == y ]]; then
      [[ -z $3 ]] && select_filesystem || filesystem=$3
      mkfs.${filesystem} $1 \
        $([[ ${filesystem} == xfs || ${filesystem} == btrfs ]] && echo "-f") \
        $([[ ${filesystem} == vfat ]] && echo "-F32") \
        $([[ $TRIM -eq 1 && ${filesystem} == ext4 ]] && echo "-E discard")
      fsck $1
      mkdir -p $2
      mount -t ${filesystem} $1 $2
      disable_partition
    fi
  }

  format_swap_partition(){
    read_input_text "Confirm format $1 partition"
    if [[ $OPTION == y ]]; then
      mkswap $1
      swapon $1
      disable_partition
    fi
  }

  create_swap(){
    swap_options=("partition" "file" "skip");
    PS3="$prompt1"
    echo -e "Select ${BYellow}${partition_name[i]}${Reset} filesystem:\n"
    select OPT in "${swap_options[@]}"; do
      case "$REPLY" in
        1)
          select partition in "${partitions_list[@]}"; do
            #get the selected number - 1
            partition_number=$(( $REPLY - 1 ))
            if contains_element "${partition}" "${partitions_list[@]}"; then
              format_swap_partition "${partition}"
            fi
            break
          done
          break
          ;;
        2)
          total_memory=`grep MemTotal /proc/meminfo | awk '{print $2/1024}' | sed 's/\..*//'`
          fallocate -l ${total_memory}M ${MNT}/swapfile
          chmod 600 ${MNT}/swapfile
          mkswap ${MNT}/swapfile
          swapon ${MNT}/swapfile
          i=$(( i + 1 ))
          break
          ;;
        3)
          i=$(( i + 1 ))
          break
          ;;
        *)
          invalid_option
          ;;
      esac
    done
  }

  check_mountpoint(){
    if mount | grep $2; then
      echo "Successfully mounted"
      disable_partition "$1"
    else
      echo "WARNING: Not Successfully mounted"
    fi
  }

#SET EFI PARTITION {{{
set_efi_partition() {
  # Automatically mount EFI System Partition to /boot for UEFI installs
  if [[ $UEFI -eq 1 ]]; then
    EFI_MNT="/boot"
    print_info "UEFI mode detected — EFI partition will be mounted at ${EFI_MNT}"
  else
    EFI_MNT=""
    print_info "BIOS mode detected — no EFI mount required."
  fi
}
#}}}

  while true; do
    PS3="$prompt1"
    if [[ ${partition_name[i]} == swap ]]; then
      create_swap
    else
      echo -e "Select ${BYellow}${partition_name[i]}${Reset} partition:\n"
      select partition in "${partitions_list[@]}"; do
        #get the selected number - 1
        partition_number=$(( $REPLY - 1 ))
        if contains_element "${partition}" "${partitions_list[@]}"; then
          case ${partition_name[i]} in
            root)
             ROOT_PART="${partition}"     # ✅ keep full path (/dev/…)
             ROOT_MNT="${partition}"
             format_partition "${partition}" "${MNT}"
              ;;
            EFI)
              set_efi_partition
              read_input_text "Format ${partition} partition"
              if [[ $OPTION == y ]]; then
                format_partition "${partition}" "${MNT}${EFI_MNT}" vfat
              else
                mkdir -p "${MNT}${EFI_MNT}"
                mount -t vfat "${partition}" "${MNT}${EFI_MNT}"
                check_mountpoint "${partition}" "${MNT}${EFI_MNT}"
              fi
              ;;
            another)
              read -p "Mountpoint [ex: /home]:" directory
              [[ $directory == "/boot" ]] && BOOT_MNT=`echo ${partition} | sed 's/[0-9]//'`
              select_filesystem
              read_input_text "Format ${partition} partition"
              if [[ $OPTION == y ]]; then
                format_partition "${partition}" "${MNT}${directory}" "${filesystem}"
              else
                read_input_text "Confirm fs="${filesystem}" part="${partition}" dir="${directory}""
                if [[ $OPTION == y ]]; then
                  mkdir -p ${MNT}${directory}
                  mount -t ${filesystem} ${partition} ${MNT}${directory}
                  check_mountpoint "${partition}" "${MNT}${directory}"
                fi
              fi
              ;;
          esac
          break
        else
          invalid_option
        fi
      done
    fi
    #check if there is no partitions left
    if [[ ${#partitions_list[@]} -eq 0 && ${partition_name[i]} != swap ]]; then
      break
    elif [[ ${partition_name[i]} == another ]]; then
      read_input_text "Configure more partitions"
      [[ $OPTION != y ]] && break
    fi
  done
  pause_function
}

# Function: copy with progress bar
copy_progress() {
    local SRC_DIR="$1"
    local DEST_DIR="$2"
    
    [[ -d "$SRC_DIR" ]] || { echo "Error: Source '$SRC_DIR' missing"; return 1; }
    [[ -d "$DEST_DIR" ]] || { echo "Error: Destination '$DEST_DIR' missing"; return 1; }
    
    local TOTAL_SIZE=$(du -sb "$SRC_DIR" | awk '{print $1}')
    echo "Total size: $(numfmt --to=iec-i --suffix=B $TOTAL_SIZE)"
    echo
    
    if tar cf - -C "$SRC_DIR" . | pv -pterb -s "$TOTAL_SIZE" | tar xpf - -C "$DEST_DIR"; then
        echo -e "\n✅ Copy Complete!"
        return 0
    else
        echo -e "\n❌ Copy Failed!"
        return 1
    fi
}

#}}}
#INSTALL ARCHBANG {{{
install_archbang(){
  print_title "INSTALL ARCHBANG"
  print_info "Installing please wait..."

  # Check if running from live environment
  check_archiso

  # copy source to new install
  if ! copy_progress /run/archiso/airootfs/ "${MNT}/"; then
    error_msg "ERROR: Failed to copy system files"
  fi

  # archiso keeps the boot kernel on the ISO media, not in the squashfs — pull it in
  mkdir -p "${MNT}/boot"
  cp -a /run/archiso/bootmnt/arch/boot/x86_64/vmlinuz-linux "${MNT}/boot/vmlinuz-linux"

  # Sync changes made during live session
  UPPERDIR=$(find /run/archiso/cowspace -type d -path "*/persistent_*/x86_64/upperdir" 2>/dev/null | head -1)
  if [[ -n "$UPPERDIR" && -d "$UPPERDIR" ]]; then
    print_info "Syncing live session changes..."
    rsync -av "$UPPERDIR/" "${MNT}/" >/dev/null 2>&1 || print_warning "Cowspace sync had errors (non-fatal)"
  fi

  # Copy the current wallpaper to a fixed path for greetd's login theme, before
  # /etc/skel is deleted later in this function
  WALLPAPER_NAME=$(sed -n 's#.*swaybg -i [^ ]*/\([^ ]*\) .*#\1#p' "${MNT}/etc/skel/.config/mango/config.conf" 2>/dev/null | head -1)
  if [[ -n "$WALLPAPER_NAME" && -f "${MNT}/etc/skel/Backgrounds/${WALLPAPER_NAME}" ]]; then
    mkdir -p "${MNT}/usr/share/backgrounds/archbang"
    cp -a "${MNT}/etc/skel/Backgrounds/${WALLPAPER_NAME}" "${MNT}/usr/share/backgrounds/archbang/current"
  fi

  # Generate unique machine id
  arch_chroot "systemd-machine-id-setup"

  # Convert mkinitcpio preset from archiso to standard for installed system
  cat > ${MNT}/etc/mkinitcpio.d/linux.preset <<'EOF'
# SPDX-License-Identifier: GPL-3.0-or-later
# mkinitcpio preset file for the 'linux' package

PRESETS=('default' 'fallback')
ALL_kver='/boot/vmlinuz-linux'
ALL_config='/etc/mkinitcpio.conf'

default_image="/boot/initramfs-linux.img"
fallback_image="/boot/initramfs-linux-fallback.img"
fallback_options="-S autodetect"
EOF

  # Remove abinstall from target device
  rm -f ${MNT}/home/${LIVE_USER}/Scripts/abinstall &> /dev/null

  # remove autologin from install
  rm -r ${MNT}/etc/systemd/system/getty@tty1.service.d &>/dev/null

  # systemd journald configuration
  rm ${MNT}/etc/systemd/system/default.target &> /dev/null
  sed -i 's/volatile/auto/g' ${MNT}/etc/systemd/journald.conf.d/volatile-storage.conf
  mv ${MNT}/etc/systemd/journald.conf.d/volatile-storage.conf ${MNT}/etc/systemd/journald.conf.d/auto-storage.conf

  # remove pacman-init.service link
  unlink ${MNT}/etc/systemd/system/multi-user.target.wants/pacman-init.service &>/dev/null
  rm -f ${MNT}/etc/systemd/system/pacman-init.service

  rm -f ${MNT}/etc/systemd/system/etc-pacman.d-gnupg.mount

  # clean out live user overlay files from /etc/skel on new install
  rm -r ${MNT}/etc/skel &>/dev/null

  # Revert gparted to stock version without sudo
  #sed -i 's|^Exec=sudo /usr/bin/gparted|Exec=/usr/bin/gparted|' ${MNT}/usr/share/applications/gparted.desktop

  # Restore gparted visibility in menus
  sed -i '/^Hidden=true/d' ${MNT}/usr/share/applications/gparted.desktop

  # Revert live NOPASSWD sudo — require password on installed system
  sed -i 's/^%wheel ALL=(ALL:ALL) NOPASSWD: ALL/# %wheel ALL=(ALL:ALL) NOPASSWD: ALL/' ${MNT}/etc/sudoers
  sed -i 's/^# %wheel ALL=(ALL:ALL) ALL$/%wheel ALL=(ALL:ALL) ALL/' ${MNT}/etc/sudoers

}
#}}}

#CONFIGURE FSTAB {{{
configure_fstab(){
  genfstab -U "$MNT" > "${MNT}/etc/fstab"
}
#}}}

#CONFIGURE HOSTNAME {{{
configure_hostname() {
  print_title "HOSTNAME - ${WIKI}/hostname"
  print_info "A host name identifies your machine on a network (max 63 chars)."

  if [[ $INTERACTIVE -eq 1 && -z "$host_name" ]]; then
    read -p "Hostname [ex: arch]: " host_name
  fi

  host_name="${host_name:-archbang}"

  print_info "Using hostname: ${host_name}"
  echo "${host_name}" > "${MNT}/etc/hostname"

  arch_chroot "cat > /etc/hosts <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${host_name}.localdomain ${host_name}
EOF"
}

#}}}
#CONFIGURE TIMEZONE {{{
configure_timezone(){
  print_title "TIMEZONE - ${WIKI}/Timezone"
  print_info "In an operating system the time (clock) is determined by four parts: Time value, Time standard, Time Zone, and DST (Daylight Saving Time if applicable)."
  if [[ -n "$DERIVED_TZ" && -e "/usr/share/zoneinfo/${DERIVED_TZ}" ]]; then
    ZONE="${DERIVED_TZ%%/*}"
    SUBZONE="${DERIVED_TZ#*/}"
    print_success "Using timezone ${DERIVED_TZ} (derived from ${LOCATION:-your location})."
  else
    OPTION=n
    while [[ $OPTION != y ]]; do
      settimezone
      read_input_text "Confirm timezone (${ZONE}/${SUBZONE})"
    done
  fi
  arch_chroot "ln -sf /usr/share/zoneinfo/${ZONE}/${SUBZONE} /etc/localtime"
}
#}}}
#CONFIGURE HARDWARECLOCK {{{
configure_hardwareclock(){
#  print_title "HARDWARE CLOCK - ${WIKI}/Hardware_Clock"
#  print_info "Setting hardware clock to UTC (default Arch convention)."

  # Always use UTC
  arch_chroot "hwclock --systohc --utc"

#  print_success "Hardware clock set to UTC."
}
#}}}
#CONFIGURE LOCALE {{{
configure_locale(){
  print_title "LOCALE - ${WIKI}/Locale"
  print_info "Locales are used in Linux to define which language the user uses & character sets."
  if [[ -n "$DERIVED_LOCALE" ]] && grep -q "^#\{0,1\}${DERIVED_LOCALE}.*UTF-8" /etc/locale.gen; then
    LOCALE="$DERIVED_LOCALE"
    LOCALE_UTF8="${LOCALE}.UTF-8"
    print_success "Using locale ${LOCALE_UTF8}."
  else
    OPTION=n
    while [[ $OPTION != y ]]; do
      setlocale
      read_input_text "Confirm locale ($LOCALE)"
    done
  fi
  echo 'LANG="'$LOCALE_UTF8'"' > ${MNT}/etc/locale.conf
  arch_chroot "sed -i '/en_US\.UTF-8/ s/^#*/#/'  /etc/locale.gen"
  arch_chroot "sed -i '/'${LOCALE_UTF8}'/s/^#//' /etc/locale.gen"
  arch_chroot "locale-gen"
}
#}}}
#CONFIGURE MKINITCPIO {{{
configure_mkinitcpio(){
    print_title "Configuring mkinitcpio"
    print_info "Setting up initramfs hooks based on your system configuration."

    # Determine hooks based on setup (systemd-based modern configuration)
    # No 'autodetect': it trims the initramfs to only the drivers loaded on
    # the installing machine, which breaks booting an install on different
    # hardware (e.g. a portable USB install moved to another machine).
    if [[ $LUKS -eq 1 && $LVM -eq 1 ]]; then
        MKINITCPIO_HOOKS="base systemd microcode modconf kms keyboard keymap sd-vconsole sd-encrypt block lvm2 filesystems fsck"
    elif [[ $LUKS -eq 1 ]]; then
        MKINITCPIO_HOOKS="base systemd microcode modconf kms keyboard keymap sd-vconsole sd-encrypt block filesystems fsck"
    elif [[ $LVM -eq 1 ]]; then
        MKINITCPIO_HOOKS="base systemd microcode modconf kms keyboard keymap sd-vconsole block lvm2 filesystems fsck"
    else
        MKINITCPIO_HOOKS="base systemd microcode modconf kms keyboard keymap sd-vconsole block filesystems fsck"
    fi

    # Update mkinitcpio.conf with hooks
    arch_chroot "sed -i -E 's|^HOOKS=.*|HOOKS=(${MKINITCPIO_HOOKS})|' /etc/mkinitcpio.conf"

    # Comment out xz compression and compression options to use zstd default for installed system
    arch_chroot "sed -i 's/^COMPRESSION=\"xz\"/#COMPRESSION=\"xz\"/' /etc/mkinitcpio.conf"
    arch_chroot "sed -i 's/^COMPRESSION_OPTIONS=/#COMPRESSION_OPTIONS=/' /etc/mkinitcpio.conf"

    # Rebuild initramfs
    arch_chroot "mkinitcpio -p linux"

    print_info "Initramfs configuration complete."
    pause_function
}
#}}}
#CONFIGURE GREETER {{{
configure_greeter(){
    print_title "Configuring login screen"
    print_info "Setting up greetd (cage + gtkgreet) as the installed system's graphical login manager. The live ISO keeps its own autologin and is unaffected."

    mkdir -p ${MNT}/etc/greetd

    cat > ${MNT}/etc/greetd/config.toml <<'EOF'
[terminal]
vt = 1

[default_session]
command = "cage -s -- gtkgreet -s /etc/greetd/gtkgreet.css"
user = "greeter"
# greetd-greeter has no matching /etc/pam.d file; reuse the "greetd" PAM service instead
service = "greetd"
EOF

    # gtkgreet's session dropdown reads this flat list, not .desktop files
    echo "mango" > ${MNT}/etc/greetd/environments

    # gtkgreet.css is not written here — already copied by install_archbang and
    # kept current by the archbang-theme skill; writing it here would clobber that

    # GTK_THEME via /etc/environment so gtkgreet matches the desktop's adw-gtk3-dark
    echo "GTK_THEME=adw-gtk3-dark" >> ${MNT}/etc/environment

    arch_chroot "systemctl enable greetd.service"
    arch_chroot "systemctl set-default graphical.target"

    print_info "Greeter configuration complete."
    pause_function
}
#}}}

#CONFIGURE BOOTLOADER {{{
# {{{ CONFIGURE BOOTLOADER
# # {{{ CONFIGURE BOOTLOADER
configure_bootloader(){
  print_title "GRUB2 configuration"
  print_info "Installing GRUB bootloader with support for LUKS, LVM, and microcode."

  # --- Detect system mode (UEFI or BIOS) ---
  if [[ -d /sys/firmware/efi ]]; then
      UEFI=1
      print_info "UEFI mode detected"
  else
      UEFI=0
      print_info "BIOS (legacy) mode detected"
  fi

  # --- Verify EFI partition is mounted if UEFI ---
  if [[ $UEFI -eq 1 ]]; then
      if ! mount | grep -q "${MNT}/boot"; then
          print_error "EFI partition is not mounted at ${MNT}/boot!"
          lsblk -f
          return 1
      fi
  fi

  # --- Detect root partition automatically ---
  if [[ -z "$ROOT_PART" || ! -b "$ROOT_PART" ]]; then
      ROOT_PART=$(lsblk -no PATH,MOUNTPOINT | grep " ${MNT}$" | awk '{print $1}')
      print_info "Detected root partition: ${ROOT_PART}"
  fi

  if [[ -z "$ROOT_PART" || ! -b "$ROOT_PART" ]]; then
      print_error "Unable to determine root partition for GRUB setup!"
      lsblk -f
      return 1
  fi

  # --- Handle LUKS UUID detection if used ---
  if [[ $LUKS -eq 1 ]]; then
      if [[ -z "$LUKS_PART" ]]; then
          print_error "LUKS enabled but no partition recorded — run step 1 first."
          return 1
      fi
      LUKS_UUID=$(blkid -s UUID -o value "$LUKS_PART")
      if [[ -z "$LUKS_UUID" ]]; then
          print_error "Could not read UUID from LUKS partition ${LUKS_PART}!"
          return 1
      fi
      print_info "Detected LUKS UUID: $LUKS_UUID"
  fi

  # Determine BOOT_DEV (top-level disk of ROOT_PART) for BIOS-target grub-install;
  # walk up parents since ROOT_PART can be several layers deep (e.g. LVM on LUKS)
  if [[ -z "$BOOT_DEV" || ! -b "$BOOT_DEV" ]]; then
      _walk_dev="$ROOT_PART"
      for _walk_hop in 1 2 3 4 5; do
          _walk_type=$(lsblk -no TYPE "$_walk_dev" 2>/dev/null | head -1)
          [[ "$_walk_type" == "disk" ]] && break
          _walk_parent=$(lsblk -no pkname "$_walk_dev" 2>/dev/null | head -1)
          [[ -z "$_walk_parent" ]] && break
          _walk_dev="/dev/${_walk_parent}"
      done
      BOOT_DEV="$_walk_dev"
      print_info "Corrected BOOT_DEV to ${BOOT_DEV} (top-level disk of ${ROOT_PART})"
  fi
  if [[ -z "$BOOT_DEV" || ! -b "$BOOT_DEV" ]]; then
      print_error "Could not determine valid boot device!"
      lsblk -f
      return 1
  fi

  # --- Install GRUB ---
  if [[ $PORTABLE_INSTALL -eq 1 ]]; then
      # Portable USB target: install both GRUB targets so it boots UEFI and BIOS alike
      if [[ -z "$BIOS_GRUB_PART" ]]; then
          print_error "Portable install requested but no bios_grub partition was recorded — re-run Auto partitioning."
          return 1
      fi
      print_info "Installing hybrid GRUB (UEFI + BIOS) for portable USB target"

      # --removable writes the ESP fallback path instead of an NVRAM entry on this
      # build machine, since the drive needs to boot on whatever machine it ends up in
      arch_chroot "grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB --removable --recheck"
      if [[ $? -ne 0 ]]; then
          print_error "GRUB installation failed for UEFI target!"
          return 1
      fi

      grub-install --target=i386-pc --boot-directory=${MNT}/boot ${BOOT_DEV}
      if [[ $? -ne 0 ]]; then
          print_error "GRUB installation failed for BIOS target!"
          lsblk -f
          return 1
      fi
      print_success "Hybrid GRUB successfully installed to ${BOOT_DEV}"

  elif [[ $UEFI -eq 1 ]]; then
      print_info "Installing GRUB (UEFI mode) to /boot/EFI/GRUB/"
      arch_chroot "grub-install --target=x86_64-efi --efi-directory=/boot --bootloader-id=GRUB --recheck"

  else
      print_info "Installing GRUB (BIOS mode)"

      # --- Run grub-install outside chroot (BIOS) ---
      grub-install --target=i386-pc --boot-directory=${MNT}/boot ${BOOT_DEV}
      if [[ $? -ne 0 ]]; then
          print_error "GRUB installation failed for BIOS mode!"
          lsblk -f
          return 1
      fi
      print_success "GRUB successfully installed to ${BOOT_DEV}"
  fi

  # --- Build kernel parameters ---
  if [[ $LUKS -eq 1 && $LVM -eq 1 ]]; then
      ROOT_LV="${VG_NAME}-${LV_ROOT}"
      CMDLINE="cryptdevice=UUID=${LUKS_UUID}:${LUKS_NAME} root=/dev/mapper/${ROOT_LV} rw"
  elif [[ $LUKS -eq 1 ]]; then
      CMDLINE="cryptdevice=UUID=${LUKS_UUID}:${LUKS_NAME} root=/dev/mapper/${LUKS_NAME} rw"
  elif [[ $LVM -eq 1 ]]; then
      ROOT_LV="${VG_NAME}-${LV_ROOT}"
      CMDLINE="root=/dev/mapper/${ROOT_LV} rw"
  else
      partuuid=$(blkid -s PARTUUID -o value "$ROOT_PART")
      if [[ -z "$partuuid" ]]; then
          uuid=$(blkid -s UUID -o value "$ROOT_PART")
          CMDLINE="root=UUID=${uuid} rw"
          print_warning "PARTUUID not found; using filesystem UUID instead."
      else
          CMDLINE="root=PARTUUID=${partuuid} rw"
      fi
  fi

  # --- Update /etc/default/grub inside chroot ---
  arch_chroot "sed -i.bak -E 's|^GRUB_CMDLINE_LINUX=.*|GRUB_CMDLINE_LINUX=\"${CMDLINE}\"|' /etc/default/grub && rm -f /etc/default/grub.bak"

  # --- Enable GRUB cryptodisk if using LUKS ---
  if [[ $LUKS -eq 1 ]]; then
      arch_chroot "grep -q '^GRUB_ENABLE_CRYPTODISK' /etc/default/grub \
          && sed -i 's/^#GRUB_ENABLE_CRYPTODISK=.*/GRUB_ENABLE_CRYPTODISK=y/' /etc/default/grub \
          || echo 'GRUB_ENABLE_CRYPTODISK=y' >> /etc/default/grub"
  fi

  # --- Generate GRUB configuration ---
  arch_chroot "grub-mkconfig -o /boot/grub/grub.cfg"

  print_success "GRUB2 installation and configuration complete."
  pause_function
}
# }}}

# }}}

#ROOT PASSWORD {{{
root_password(){
  print_title "ROOT PASSWORD"
  print_warning "Enter your new root password"
  arch_chroot "passwd"
  pause_function
}

# SETUP NEW USER {{{
setup_user(){
  print_title "CREATE NEW USER"
  echo
  
  # Guard: if live user home is already gone, rename was already done
  if [[ ! -d ${MNT}/home/${LIVE_USER} ]]; then
    print_info "Live user already renamed — skipping."
    return 0
  fi

  # Prompt for new username with validation
  local new_username
  while true; do
    read -p "Enter the new username: " new_username
    if [[ -n "$new_username" ]] && echo "$new_username" | grep -qE '^[a-z_][a-z0-9_-]*[$]?$'; then
      break
    fi
    print_danger "Invalid username. Use lowercase letters, digits, - or _. Cannot start with a digit."
  done

  # Set password on the live user account (becomes the renamed user's password)
  print_info "Set password for ${new_username}:"
  while true; do
    arch_chroot "passwd ${LIVE_USER}" && break
  done

  # Rewrite occurrences of old username inside config files
  print_info "Updating config files..."
  arch_chroot "grep -rlI \"${LIVE_USER}\" /home/${LIVE_USER} | xargs -r sed -i \"s/${LIVE_USER}/${new_username}/g\""

  # Update system account files
  arch_chroot "sed -i \"s/${LIVE_USER}/${new_username}/g\" /etc/group"
  arch_chroot "sed -i \"s/${LIVE_USER}/${new_username}/g\" /etc/gshadow"
  arch_chroot "sed -i \"s/${LIVE_USER}/${new_username}/g\" /etc/passwd"
  arch_chroot "sed -i \"s/${LIVE_USER}/${new_username}/g\" /etc/shadow"

  # Rename home directory and fix ownership
  print_info "Renaming home directory..."
  arch_chroot "mv /home/${LIVE_USER} /home/${new_username}"

  # Ensure a dedicated group matching the new username, not the shared "users" group
  arch_chroot "getent group \"${new_username}\" >/dev/null || groupadd \"${new_username}\""
  arch_chroot "usermod -g \"${new_username}\" \"${new_username}\""
  arch_chroot "chown -R ${new_username}:${new_username} /home/${new_username}"
  
  pause_function
}

#}}}
#FINISH {{{
finish(){
  print_title "ARCHBANG INSTALL COMPLETED..."
  read_input_text "Reboot system"
  if [[ $OPTION == y ]]; then
    umount_partitions
    reboot
  fi
  exit 0
}
#}}}

#WELCOME SCREEN {{{
welcome_screen(){
  print_title "Welcome to ArchBang!"

  echo -e "${Bold}What is ArchBang?${Reset}"
  echo -e "\tArch Linux with the MangoWM Wayland compositor."
  echo -e "\tA lean, keyboard-driven Arch-based live ISO.\n"

  echo -e "${Bold}System Requirements:${Reset}"
  echo -e "\t✓ 20GB+ free disk space"
  echo -e "\t✓ 2GB+ RAM"
  echo -e "\t✓ Booted from ArchBang live ISO\n"

  echo -e "${Bold}Installation Steps (8 total):${Reset}"
  echo -e "\t1. Partition your disk (Default, LVM, or LVM+LUKS)"
  echo -e "\t2. Install ArchBang system files"
  echo -e "\t3. Set hostname"
  echo -e "\t4. Configure timezone & mirrors"
  echo -e "\t5. Set locale & language"
  echo -e "\t6. Configure desktop keyboard layout"
  echo -e "\t7. Install bootloader (GRUB)"
  echo -e "\t8. Set root password & create your user\n"

  echo -e "${BYellow}⚠ Important:${Reset}"
  echo -e "\t${Bold}All data on selected partitions will be LOST.${Reset}"
  echo -e "\t${Bold}Backup anything important before continuing!${Reset}\n"

  echo -e "${Bold}Quick Tips:${Reset}"
  echo -e "\t• Installation typically takes 5-15 minutes"
  echo -e "\t• You can retry or skip steps if something fails"
  echo -e "\t• The live user 'live' will be renamed to your chosen username"
  echo -e "\t• GRUB is the bootloader (installed automatically)\n"

  print_line
  read_input_text "Ready to begin?"
  if [[ $OPTION != y ]]; then
    print_info "Installation cancelled."
    exit 0
  fi
}
#}}}

#RUN STEP {{{
run_step() {
  local step_num="$1"
  local step_label="$2"
  shift 2
  local -a fns=("$@")

  if [[ ${checklist[$step_num]} -eq 1 ]]; then
    print_info "Step ${step_num}: ${step_label} — already complete, skipping."
    return 0
  fi

  print_line
  echo -e "# ${Bold}Step ${step_num} of 8: ${step_label}${Reset}"
  print_line
  echo ""

  # Retry/skip operates per sub-step, not by restarting the whole chain — restarting
  # from fns[0] would re-run expensive/destructive earlier sub-steps
  local i=0
  while [[ $i -lt ${#fns[@]} ]]; do
    local fn="${fns[$i]}"
    if "$fn"; then
      i=$((i + 1))
      continue
    fi

    print_danger "Step '${step_label}' failed at '${fn}'."
    read_input_text "Retry '${fn}'"
    if [[ $OPTION == y ]]; then
      continue
    fi

    read_input_text "Skip '${fn}' and continue with the rest of this step"
    if [[ $OPTION == y ]]; then
      print_danger "Skipping '${fn}' — this step's configuration may be incomplete."
      i=$((i + 1))
      continue
    fi

    error_msg "Installation aborted."
  done

  checklist[$step_num]=1
  return 0
}
#}}}

check_root
check_boot_system
detect_cpu
check_trim

welcome_screen

run_step 1 "Partition Scheme"        umount_partitions create_partition_scheme format_partitions
run_step 2 "Install ArchBang"        install_archbang configure_fstab configure_mkinitcpio configure_greeter
run_step 3 "Hostname"                configure_hostname
run_step 4 "Location"                select_location configure_timezone configure_hardwareclock configure_mirrors
run_step 5 "Locale"                  select_language configure_locale
run_step 6 "Keyboard Layout"         configure_vconsole select_xkeymap
run_step 7 "Bootloader"              configure_bootloader
run_step 8 "Root and User Setup"     root_password setup_user
finish
