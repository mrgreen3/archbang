#!/usr/bin/env python3
# shellbang — pick a wallpaper from ~/Backgrounds and re-theme mango/
# waybar/rofi/mako/greetd to match it live, using matugen for the palette.
# Also offers automatic wallpaper rotation via a systemd user timer
# (Rotate on/off, and Timer to set the switch interval in minutes).
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

HOME = Path.home()
BG_DIR = HOME / "Backgrounds"
MANGO_CONF = HOME / ".config/mango/config.conf"
WAYBAR_CSS = HOME / ".config/waybar/style.css"
ROFI_RASI = HOME / ".config/rofi/theme.rasi"
ROFI_PICKER = HOME / ".config/rofi/wallpaper.rasi"
THUMB_DIR = HOME / ".cache" / "wallpaper-thumbs"
MAKO_CONF = HOME / ".config/mako/config"
CONF_FILE = HOME / ".config/shellbang.conf"
UNIT_DIR = HOME / ".config/systemd/user"
SERVICE_UNIT = UNIT_DIR / "shellbang-rotate.service"
TIMER_UNIT = UNIT_DIR / "shellbang-rotate.timer"
SERVICE_NAME = "shellbang-rotate.service"
TIMER_NAME = "shellbang-rotate.timer"
GREETD_BG = Path("/usr/share/backgrounds/archbang/current")
GTKGREET_CSS = Path("/etc/greetd/gtkgreet.css")

WALLPAPER_SUFFIXES = (".jpg", ".jpeg", ".png", ".webp", ".bmp")
TIMER_PRESETS = [10, 15, 30, 60, 180, 720]  # minutes


def notify(summary, body=""):
    args = ["notify-send", "shellbang"]
    if summary:
        args.append(summary)
    if body:
        args.append(body)
    subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---- state/config -------------------------------------------------------

def load_conf():
    conf = {}
    if CONF_FILE.exists():
        for line in CONF_FILE.read_text().splitlines():
            if "=" in line:
                k, v = line.split("=", 1)
                conf[k.strip()] = v.strip()
    conf.setdefault("rotate", "off")
    conf.setdefault("timer", "15")
    conf.setdefault("current", "")
    conf.setdefault("greetd", "on")
    conf.setdefault("display", os.environ.get("WAYLAND_DISPLAY", ""))
    return conf


def save_conf(conf):
    CONF_FILE.parent.mkdir(parents=True, exist_ok=True)
    body = "\n".join(
        f"{k}={conf.get(k, '')}"
        for k in ("rotate", "timer", "current", "greetd", "display")
    )
    CONF_FILE.write_text(body + "\n")


def all_wallpapers():
    return sorted(
        p for p in BG_DIR.iterdir()
        if p.is_file() and p.suffix.lower() in WALLPAPER_SUFFIXES
    )


def next_wallpaper(current):
    lst = all_wallpapers()
    if not lst:
        return None
    cur = Path(current) if current else None
    if cur in lst:
        return lst[(lst.index(cur) + 1) % len(lst)]
    return lst[0]


def session_env(conf):
    """systemd user units don't inherit the session env; inject the display."""
    env = dict(os.environ)
    if conf.get("display"):
        env["WAYLAND_DISPLAY"] = conf["display"]
    return env


# ---- rotation via systemd user timer ------------------------------------

def write_rotate_units(timer_min):
    UNIT_DIR.mkdir(parents=True, exist_ok=True)
    SERVICE_UNIT.write_text(
        "[Unit]\nDescription=Rotate ArchBang wallpaper\n\n"
        "[Service]\nType=oneshot\nExecStart=%h/Scripts/shellbang --rotate\n"
    )
    TIMER_UNIT.write_text(
        "[Unit]\nDescription=Rotate ArchBang wallpaper (timer)\n\n"
        "[Timer]\nOnBootSec=60\n"
        f"OnUnitActiveSec={timer_min * 60}\n\n"
        "[Install]\nWantedBy=timers.target\n"
    )


def reload_and_enable_rotate():
    write_rotate_units(int(load_conf().get("timer", "15")))
    subprocess.run(["systemctl", "--user", "daemon-reload"])
    # Immediate first switch, then let the timer take over on its interval.
    subprocess.run(["systemctl", "--user", "enable", "--now", TIMER_NAME],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["systemctl", "--user", "start", SERVICE_NAME],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def disable_rotate():
    subprocess.run(["systemctl", "--user", "disable", "--now", TIMER_NAME],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def restart_timer():
    if load_conf().get("rotate") == "on":
        write_rotate_units(int(load_conf().get("timer", "15")))
        subprocess.run(["systemctl", "--user", "daemon-reload"])
        subprocess.run(["systemctl", "--user", "restart", TIMER_NAME],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---- the actual theming --------------------------------------------------

def wallpaper_feed():
    """Thumbnail-grid rofi entries (same as the desktop wallpaper-switch tool)."""
    THUMB_DIR.mkdir(parents=True, exist_ok=True)
    lines = []
    for p in sorted(BG_DIR.glob("*")):
        if not p.is_file() or p.suffix.lower() not in WALLPAPER_SUFFIXES:
            continue
        thumb = THUMB_DIR / (hashlib.md5(str(p).encode()).hexdigest()[:16] + ".png")
        if not thumb.exists():
            subprocess.run(
                ["vipsthumbnail", str(p), "-s", "320x200", "--crop", "centre",
                 "-o", str(thumb)],
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        lines.append(f"{p.stem}\0icon\x1f{thumb}")
    return lines


def pick_wallpaper():
    proc = subprocess.run(
        ["rofi", "-dmenu", "-show-icons", "-theme", str(ROFI_PICKER),
         "-mesg", "wallpapers — type to filter"],
        input="\n".join(wallpaper_feed()), capture_output=True, text=True,
        env=session_env(load_conf()))
    label = proc.stdout.strip()
    if not label:
        return None
    for p in BG_DIR.glob("*"):
        if p.is_file() and p.stem == label:
            return p
    return None


def get_palette(wallpaper):
    out = subprocess.run(
        ["matugen", "image", str(wallpaper), "--json", "hex", "--dry-run",
         "--mode", "dark", "--prefer", "saturation"],
        capture_output=True, text=True, env=session_env(load_conf()),
    ).stdout
    if not out.strip():
        return None
    data = json.loads(out)

    def role(name):
        return data["colors"][name]["dark"]["color"].lstrip("#")

    return {
        "bg": role("background"),
        "surface": role("surface_variant"),
        "fg": role("on_surface"),
        "fgdim": role("on_surface_variant"),
        "accent": role("primary"),
        "onaccent": role("on_primary"),
        "urgent": role("error"),
        "green": role("tertiary"),
        "yellow": role("secondary"),
    }


def theme_mango(p, wallpaper):
    conf = MANGO_CONF.read_text()
    mapping = {
        "rootcolor": p["bg"], "focuscolor": p["accent"], "maximizescreencolor": p["surface"],
        "urgentcolor": p["urgent"], "scratchpadcolor": p["surface"], "globalcolor": p["fgdim"],
        "overlaycolor": p["fg"],
    }
    for key, val in mapping.items():
        conf = re.sub(
            rf"(?m)^{re.escape(key)}=0x[0-9a-fA-F]{{6}}([0-9a-fA-F]{{2}})$",
            lambda m, val=val: f"{key}=0x{val}{m.group(1)}",
            conf, count=1,
        )
    conf = re.sub(
        r"(?m)^exec-once=swaybg -i .* -m fill",
        f"exec-once=swaybg -i {wallpaper} -m fill",
        conf, count=1,
    )
    MANGO_CONF.write_text(conf)


def theme_waybar(p):
    css = WAYBAR_CSS.read_text()
    mapping = {
        "bg": p["bg"], "surface": p["surface"], "fg": p["fg"], "fg-dim": p["fgdim"],
        "accent": p["accent"], "red": p["urgent"], "green": p["green"],
        "yellow": p["yellow"], "on-accent": p["onaccent"],
    }
    for name, val in mapping.items():
        css = re.sub(
            rf"(@define-color\s+{re.escape(name)}\s+)#[0-9a-fA-F]{{6}};",
            rf"\1#{val};", css, count=1,
        )
    WAYBAR_CSS.write_text(css)


def theme_rofi(p):
    # theme both the app-launcher theme and the wallpaper-picker grid
    mapping = {
        "bg": p["bg"], "bg-alt": p["surface"], "fg": p["fg"], "fg-dim": p["fgdim"],
        "accent": p["accent"], "urgent": p["urgent"], "selected-fg": p["onaccent"],
    }
    for path in (ROFI_RASI, ROFI_PICKER):
        rasi = path.read_text()
        for name, val in mapping.items():
            rasi = re.sub(
                rf"(?m)^(\s*{re.escape(name)}:\s*)#[0-9a-fA-F]{{6}}([0-9a-fA-F]{{2}})?;",
                rf"\1#{val}\2;", rasi, count=1)
        path.write_text(rasi)


def theme_mako(p):
    conf = MAKO_CONF.read_text()
    mapping = {
        "background-color": p["bg"], "text-color": p["fg"], "border-color": p["accent"],
    }
    for key, val in mapping.items():
        conf = re.sub(
            rf"(?m)^{re.escape(key)}=#[0-9a-fA-F]{{6}}([0-9a-fA-F]{{2}})?",
            lambda m, val=val: f"{key}=#{val}{m.group(1) or ''}",
            conf, count=1,
        )
    MAKO_CONF.write_text(conf)


def sub_block(pattern, repl, text):
    return re.sub(pattern, repl, text, count=1, flags=re.S)


def theme_greetd(wallpaper, bg, surface, fg, fgdim, accent, onaccent):
    GREETD_BG.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(wallpaper, GREETD_BG)
    os.chmod(GREETD_BG, 0o644)

    sr, sg, sb = int(surface[0:2], 16), int(surface[2:4], 16), int(surface[4:6], 16)
    css = GTKGREET_CSS.read_text()
    css = sub_block(r'(window \{.*?background-color:) #[0-9a-fA-F]{6};', rf'\1 #{bg};', css)
    css = sub_block(r'(box#body \{.*?background-color: )rgba\(\d+, \d+, \d+', rf'\1rgba({sr}, {sg}, {sb}', css)
    css = sub_block(r'(box#body \{.*?border: 2px solid) #[0-9a-fA-F]{6};', rf'\1 #{accent};', css)
    css = sub_block(r'(label \{.*?color:) #[0-9a-fA-F]{6};', rf'\1 #{fg};', css)
    css = sub_block(r'(entry \{.*?background-color:) #[0-9a-fA-F]{6};', rf'\1 #{surface};', css)
    css = sub_block(r'(entry \{.*?\n\s*color:) #[0-9a-fA-F]{6};', rf'\1 #{fg};', css)
    css = sub_block(r'(entry \{.*?caret-color:) #[0-9a-fA-F]{6};', rf'\1 #{fg};', css)
    css = sub_block(r'(entry \{.*?border: 1px solid) #[0-9a-fA-F]{6};', rf'\1 #{fgdim};', css)
    css = sub_block(r'(entry:focus \{.*?border-color:) #[0-9a-fA-F]{6};', rf'\1 #{accent};', css)
    css = sub_block(r'(button \{.*?background-color:) #[0-9a-fA-F]{6};', rf'\1 #{accent};', css)
    css = sub_block(r'(button \{.*?\n\s*color:) #[0-9a-fA-F]{6};', rf'\1 #{onaccent};', css)
    css = sub_block(r'(button:hover \{.*?background-color:) #[0-9a-fA-F]{6};', rf'\1 #{accent};', css)
    css = sub_block(r'(combobox \{.*?color:) #[0-9a-fA-F]{6};', rf'\1 #{fg};', css)
    GTKGREET_CSS.write_text(css)


def apply_theme(wallpaper, conf, force=False):
    if not wallpaper.is_file():
        notify("wallpaper not found", str(wallpaper))
        return False
    if not force and conf.get("current") == str(wallpaper):
        notify("already active", wallpaper.name)
        return False

    subprocess.run(["pkill", "-x", "swaybg"])
    subprocess.Popen(["swaybg", "-i", str(wallpaper), "-m", "fill"],
                     start_new_session=True, env=session_env(conf))

    palette = get_palette(wallpaper)
    if palette is None:
        notify("matugen failed, wallpaper set but colours unchanged")
        return True

    theme_mango(palette, wallpaper)
    theme_waybar(palette)
    theme_rofi(palette)
    theme_mako(palette)
    subprocess.run(["mmsg", "dispatch", "reload_config"],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   env=session_env(conf))

    if (conf.get("greetd", "on") == "on"
            and subprocess.run(["sudo", "-n", "true"], env=session_env(conf),
                               stdout=subprocess.DEVNULL,
                               stderr=subprocess.DEVNULL).returncode == 0):
        subprocess.run([
            "sudo", sys.executable, str(Path(__file__).resolve()), "--greetd",
            str(wallpaper), palette["bg"], palette["surface"], palette["fg"],
            palette["fgdim"], palette["accent"], palette["onaccent"],
        ], env=session_env(conf))

    subprocess.run(["pkill", "-x", "waybar"], env=session_env(conf))
    subprocess.Popen(["waybar"], start_new_session=True, env=session_env(conf))
    subprocess.run(["makoctl", "reload"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                    env=session_env(conf))

    conf["current"] = str(wallpaper)
    save_conf(conf)
    notify("Theme Updated", wallpaper.name)
    return True


# ---- menu ----------------------------------------------------------------

def rofi_menu(entries, prompt):
    proc = subprocess.run(
        ["rofi", "-dmenu", "-show-icons", "-p", prompt, "-theme", str(ROFI_RASI),
         "-theme-str", f"listview {{ lines: {len(entries)}; }}"],
        input="\n".join(entries), capture_output=True, text=True,
        env=session_env(load_conf()),
    )
    return proc.stdout.strip()


def toggle_rotate(conf):
    if conf.get("rotate") == "on":
        disable_rotate()
        conf["rotate"] = "off"
        save_conf(conf)
        notify("Rotation off")
    else:
        conf["rotate"] = "on"
        save_conf(conf)
        notify("Rotation on",
               f"switching every {conf.get('timer')} min")
        reload_and_enable_rotate()


def set_timer(conf):
    labels = [f"{m} min" if m < 60 else f"{m // 60} hour{'s' if m >= 120 else ''}"
               for m in TIMER_PRESETS]
    choice = rofi_menu(labels, "Timer")
    if not choice:
        return
    try:
        minutes = TIMER_PRESETS[labels.index(choice)]
    except ValueError:
        return
    conf["timer"] = str(minutes)
    save_conf(conf)
    restart_timer()
    notify("Rotation timer", f"{minutes} min")


def run_menu():
    conf = load_conf()
    rotate_on = conf.get("rotate") == "on"
    timer_min = conf.get("timer", "15")
    entries = ["Wallpaper\0icon\x1fimage-x-generic"]
    entries.append("Rotate: on\0icon\x1fmedia-playback-start"
                   if rotate_on else "Rotate: off\0icon\x1fmedia-playback-stop")
    if rotate_on:
        entries.append(f"Timer: {timer_min} min\0icon\x1ftimer")
    choice = rofi_menu(entries, "Themebang")

    if choice.startswith("Wallpaper"):
        wp = pick_wallpaper()
        if wp:
            apply_theme(wp, conf)
    elif choice.startswith("Rotate"):
        toggle_rotate(load_conf())
    elif choice.startswith("Timer"):
        set_timer(load_conf())


def rotate_once():
    conf = load_conf()
    if conf.get("rotate") != "on":
        return
    wp = next_wallpaper(conf.get("current", ""))
    if not wp:
        notify("no wallpapers found", str(BG_DIR))
        return
    apply_theme(wp, conf)


def main():
    run_menu()


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--greetd":
        theme_greetd(*sys.argv[2:9])
    elif len(sys.argv) > 1 and sys.argv[1] == "--rotate":
        rotate_once()
    else:
        main()
